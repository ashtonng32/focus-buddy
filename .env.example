# Slice 1 needs only these. Later slices add Notion, VAPID, CRON_SECRET (see docs/PRD.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ALLOWED_EMAIL=
# TASKS_PROVIDER=notion (default) or linear (see docs/PRD-LINEAR.md).
