# Slice 3: NOTION_TOKEN, NOTION_TASKS_DS, NOTION_WORKLOG_DS, NOTION_DAILYLOG_DS (V2), NOTION_BREAKS_PAGE, APP_TIMEZONE
# Slice 2
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Edge Function secrets (set with `supabase secrets set`): CRON_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
